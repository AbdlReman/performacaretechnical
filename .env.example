# Admin panel login key (server-only, never expose as NEXT_PUBLIC_*)
ADMIN_SECRET_KEY=your-strong-admin-secret-here

# MongoDB connection (quotes + subscribers + blogs)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# TinyMCE (browser)
NEXT_PUBLIC_TINYMCE_API_KEY=your-tinymce-api-key

# Hostinger SMTP (quote notifications)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@yourdomain.com
EMAIL_PASS=your-email-password
EMAIL_FROM_NAME=Performacare Technical
EMAIL_TO=your-inbox@gmail.com

# Public site URL (used in email logo + CTA links)
NEXT_PUBLIC_SITE_URL=https://performacaretechnical.ae
